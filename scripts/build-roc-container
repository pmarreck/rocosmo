#!/usr/bin/env bash
# Build the Roc compiler as one rocosmo container: the pinned Roc nightly for
# every OS/CPU it is published for (Linux x86_64/aarch64, macOS x86_64/arm64,
# Windows x86_64), joined by rocosmo-pack. The result runs `roc` natively on
# each of them; name it roc.exe on Windows.
# Usage: scripts/build-roc-container OUT [--level N]
#   --level N  zstd level, 1-22 (default 19: 400 MB in about 12 minutes and
#              2 GB of memory; 3 takes about 16 seconds and is 9% larger)
# Environment: ROCOSMO_PACK (default: build zig-out/bin/rocosmo-pack).
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -z "${IN_NIX_SHELL-}" ]; then
	exec nix develop "$root" -c "$root/scripts/build-roc-container" "$@"
fi
usage() { printf 'usage: build-roc-container OUT [--level N]\n' >&2; exit 2; }
out="" level=19
while [ $# -gt 0 ]; do
	case "$1" in
		--level) [ $# -ge 2 ] || usage; level="$2"; shift 2;;
		-h|--help) sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0;;
		-*) usage;;
		*) [ -z "$out" ] || usage; out="$1"; shift;;
	esac
done
[ -n "$out" ] || usage

roc_all="$(nix build "$root#roc-all-targets" --no-link --print-out-paths)" || { echo "build-roc-container: cannot fetch the Roc nightlies" >&2; exit 1; }
pack="${ROCOSMO_PACK-}"
if [ -z "$pack" ]; then
	(cd "$root" && zig build --summary none) || exit 1
	pack="$root/zig-out/bin/rocosmo-pack"
fi
exec "$pack" --layout zstd --level "$level" --app-id dev.rocosmo.roc \
	--windows-x86_64 "$roc_all/windows-x86_64/roc.exe" \
	--linux-x86_64 "$roc_all/linux-x86_64/roc" --linux-aarch64 "$roc_all/linux-aarch64/roc" \
	--macos-x86_64 "$roc_all/macos-x86_64/roc" --macos-arm64 "$roc_all/macos-arm64/roc" \
	-o "$out"
