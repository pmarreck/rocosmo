# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=2

annotate=[
	. = One file that runs natively on Linux, macOS, Windows and the BSDs; packer, runtimes and the rocosmo command
	.dirtree-state = dirtree's saved settings and the per-file notes shown by dirtree
	.gitignore = Ignores local/ host aliases, inbox/, Nix results and direnv state
	APE_DISPATCH.md = How Cosmopolitan APE routes OS/CPU inside one file, and rocosmo's reuse and enhancements
	INTENT.md = Project purpose: research brief (completed) and the current build phase
	LICENSE = MIT license for rocosmo
	PLAN.md = Open work, decisions awaiting BDFN, later items
	README.md = Outside-reader overview: one-command use, platforms, containers, layouts
	RESEARCH.md = Feasibility report: pins, matrix, receipts, options, constraints, recommendation
	TECHNIQUE.md = How a container works: formats, dispatcher, raw/zstd layouts, Linux memfd, limits
	THIRD_PARTY_NOTICES.md = Zstandard BSD license notice for rocosmo-pack and zstd-layout containers
	build.zig = Builds librocosmo, rocosmo-pack and core unit tests
	docs/PLAN_LOG.md = Completed PLAN.md items retired by plan-retire, with section paths
	docs/ZSTD_DECODER_SPEC.md = Spec for a minimum zstd decoder for the runtimes: required frame/block/entropy features, raw-content reference (patch-from) rule, design latitude, acceptance tests
