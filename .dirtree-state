	src/rocosmo_rt.h = C header for the runtime core API
	src/rt_ffi.zig = Runtime core C API: plan and decode a target, no I/O
	src/runtime.c = rocosmo-runtime: rebuilds a target payload from a zstd-layout container
	src/targets.zig = Known OS/CPU targets: name, uname pattern, CPU; the one table for CLI flags, layout and runtimes
	src/tests.zig = Root for all core unit tests
	src/winlauncher.zig = Opt-in Windows launcher PE (x86_64, kernel32-only): rebuilds the app's PE from the container into %LOCALAPPDATA% and runs it
