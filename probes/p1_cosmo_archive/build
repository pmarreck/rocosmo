#!/usr/bin/env bash
# P1 build: Roc archives per arch -> cosmocc per-arch links -> apelink fat APE.
# Usage: build OUTDIR   (expects roc and cosmocc on PATH, e.g. via nix develop)
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
out="${1:?usage: build OUTDIR}"
mkdir -p "$out"
cosmo_bin="$(dirname "$(command -v cosmocc)")"
roc_src="$out/src"
rm -rf -- "$roc_src"; mkdir -p "$roc_src"
cp -r -- "$here/app.roc" "$here/platform" "$roc_src/"

set -e
roc build --target=x64musl --output="$out/app_x64.a" "$roc_src/app.roc"
roc build --target=arm64musl --output="$out/app_arm64.a" "$roc_src/app.roc"
"$cosmo_bin/x86_64-unknown-cosmo-cc" -O2 -o "$out/app.x86_64.dbg" "$here/host.c" "$out/app_x64.a"
"$cosmo_bin/aarch64-unknown-cosmo-cc" -O2 -o "$out/app.aarch64.elf" "$here/host.c" "$out/app_arm64.a"
# The per-arch drivers emit APE wrappers for x86_64; apelink needs the raw ELFs.
x64_elf="$out/app.x86_64.dbg"; [ -f "$out/app.x86_64.dbg.com.dbg" ] && x64_elf="$out/app.x86_64.dbg.com.dbg"
arm_elf="$out/app.aarch64.elf"; [ -f "$out/app.aarch64.elf.dbg" ] && arm_elf="$out/app.aarch64.elf.dbg"
"$cosmo_bin/apelink" \
	-l "$cosmo_bin/ape-x86_64.elf" \
	-l "$cosmo_bin/ape-aarch64.elf" \
	-M "$cosmo_bin/ape-m1.c" \
	-o "$out/app.com" \
	"$x64_elf" "$arm_elf"
