#!/usr/bin/env bash
# Generate a Roc app with N distinct, chained functions so Roc-generated code,
# not the host, dominates the binary (synthetic code volume for P5).
# Usage: gen-roc-app N > app.roc   (then build with probes/p2_native_targets)
n="$1"
echo 'app [main!] { pf: platform "./platform/main.roc" }'
echo
echo 'import pf.Host'
for ((i = 0; i < n; i++)); do
	a=$(( (i * 7919) % 97 + 1 )) b=$(( (i * 104729) % 89 + 2 )) c=$(( (i * 31) % 13 + 2 )) d=$(( i % 5 ))
	cat <<R

f$i : I64 -> I64
f$i = |x| {
    list = [x, x + $a, x // $c, x - $b, $i]
    folded = list.fold($d, |acc, e| if e > acc (acc + e // $c) else (acc - e // $b + $a))
    var \$k = 0
    var \$s = folded
    while \$k < $c {
        \$s = \$s // 2 + (list.get(\$k.to_u64()) ?? $b) // $c
        \$k = \$k + 1
    }
    if \$s > $((a * 3)) \$s // $c else \$s + $a
}
R
done
echo
echo 'main! : I64 => I64'
echo 'main! = |n| {'
echo '    a0 = f0(n)'
for ((i = 1; i < n; i++)); do echo "    a$i = f$i(a$((i - 1)) // 3 + n)"; done
echo "    Host.double!(a$((n - 1))) + 1"
echo '}'
